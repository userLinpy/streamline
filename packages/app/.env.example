# ============================================================
# BDD — PostgreSQL 16
# ============================================================
# prismaUser — RLS activée, pour les Server Actions utilisateur
DATABASE_URL="postgresql://postgres:zeliandev@localhost:5433/zelian?schema=public"
# prismaService — Bypass RLS, pour les crons et webhooks système
DATABASE_URL_SERVICE="postgresql://postgres:zeliandev@localhost:5433/zelian?schema=public"

# ============================================================
# Auth — Supabase Cloud (UNIQUEMENT pour l'auth)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SECRET — ne jamais préfixer NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ============================================================
# Sécurité — Chiffrement AES-256-GCM
# ============================================================
ENCRYPTION_KEY="<64 caractères hexadécimaux>"

# ============================================================
# Emails — Resend
# ============================================================
RESEND_API_KEY="re_..."
RESEND_WEBHOOK_SECRET="whsec_..."

# ============================================================
# Optionnels
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_STACK_TOKEN=""
NODE_ENV="development"
