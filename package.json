{
  "name": "zelian-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @zelian/app dev",
    "dev:docker": "docker compose up -d",
    "build": "pnpm --filter @zelian/app build",
    "start": "pnpm --filter @zelian/app start",
    "lint": "pnpm --filter @zelian/app lint",
    "typecheck": "pnpm --filter @zelian/app typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @zelian/app test:e2e",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @zelian/app db:generate",
    "db:migrate": "pnpm --filter @zelian/app db:migrate",
    "db:studio": "pnpm --filter @zelian/app db:studio",
    "db:push": "pnpm --filter @zelian/app db:push",
    "clean": "pnpm -r exec rm -rf node_modules .next dist build coverage"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
