{
  "name": "zelian-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @zelian/app dev",
    "dev:docker": "docker compose up -d",
    "build": "pnpm --filter @zelian/app build",
    "start": "pnpm --filter @zelian/app start",
    "lint": "pnpm --filter @zelian/app lint",
    "typecheck": "pnpm --filter @zelian/app typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @zelian/app test:e2e",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "clean": "pnpm -r exec rm -rf node_modules .next dist build coverage"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "prisma": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
